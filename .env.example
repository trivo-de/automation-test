# ===== Neo4j =====
# NEO4J_AUTH và NEO4J_PASSWORD PHẢI trùng mật khẩu nhau, nếu không app không kết nối được.
# Mật khẩu tối thiểu 8 ký tự.
NEO4J_AUTH=neo4j/doi_mat_khau_nay
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=doi_mat_khau_nay

# ===== Airflow (http://localhost:8080) =====
# Tài khoản quản trị để đăng nhập giao diện Airflow. Đổi mật khẩu ở đây rồi chạy
# `docker compose up -d airflow` là mật khẩu được cập nhật.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=doi_mat_khau_nay

# ===== Đường dẫn trong container — không cần sửa =====
DATA_DIR=/app/data
OUT_DIR=/app/artifacts
DUCKDB_PATH=/app/artifacts/vienvien.duckdb

# ===== Tham số bài toán =====
# Không viết chú thích cùng dòng với giá trị: Docker Compose đời cũ
# không cắt phần sau dấu # và biến sẽ nhận sai giá trị.

# nhịp ra quyết định: day (từng phiên), week (phiên cuối tuần) hoặc month (cuối tháng)
DECISION_FREQ=day
# số phiên nhìn tới để tính lợi suất (nhãn)
HORIZON=20
# số mã khuyến nghị trả về
TOPK=10
# cửa sổ (ngày) tính đồng mua trên đồ thị
COOC_WINDOW=180
# giữ bao nhiêu mã đồng mua mạnh nhất cho mỗi mã
COOC_TOPN=25

# số khách tương tự giữ lại cho mỗi khách (tính trên đồ thị Neo4j)
PEER_TOPK=20
# số mã mua chung tối thiểu để hai khách được coi là tương tự
PEER_MIN_SHARED=2

# trọng số tín hiệu nghiên cứu trong điểm MUA cuối cùng (phần còn lại là hành vi)
MARKET_WEIGHT=0.60
# chu kỳ bán rã cho độ gần giao dịch khi tính sở thích khách (ngày)
BEHAVIOR_HALF_LIFE=90

# phí mua tính vào giá vốn khi dựng lại vị thế từ giao dịch
BUY_FEE=0.0015

# ===== Kỳ hạn đầu tư suy ra từ thời gian nắm giữ =====
# bán hết trong số ngày này là bằng chứng NGẮN HẠN
SHORT_HOLD_DAYS=30
# giữ lâu hơn số ngày này là bằng chứng DÀI HẠN
LONG_HOLD_DAYS=90
# tỷ lệ bằng chứng tối thiểu để xếp khách vào SHORT hoặc LONG
HOLD_EVIDENCE_THRESHOLD=0.50
# số vòng mua-bán tối thiểu trước khi kết luận
HOLD_MIN_EVIDENCE=3
# cửa sổ (ngày) đo nhịp giao dịch gần đây của khách
RECENT_WINDOW=90

# ===== Gradio =====
GRADIO_PORT=7860

# ===== Trần bộ nhớ DuckDB, phải nhỏ hơn mem_limit của container (5g) =====
DUCKDB_MEMORY=3GB
# số luồng DuckDB; càng nhiều luồng càng tốn RAM ngoài trần ở trên
DUCKDB_THREADS=4
# số lát cắt thời gian gửi tới Neo4j cùng lúc ở bước đồ thị
GRAPH_WORKERS=2
